{
  "tasks": {
    "install": "cd client && deno install",
    "dev": "cd client && deno task dev",
    "build": "cd client && deno task build",
    "check:client": "cd client && deno task check",
    "check:server": "deno check server/main.ts",
    "check": "deno task check:client && deno task check:server",
    "serve": "deno run --allow-net --allow-read --allow-env server/main.ts"
  }
}
